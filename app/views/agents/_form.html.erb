<%= form_with model: agent, class: "card w-full" do |f| %>
  <% if agent.errors.any? %>
    <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <%= agent.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: "form-input" %>
    </div>

    <div>
      <%= f.label :llm_profile_id, class: "form-label" %>
      <%= f.select :llm_profile_id, llm_profiles.map { |profile| [ profile.name, profile.id ] },
            { include_blank: t("agents.form.select_profile") }, class: "form-input" %>
    </div>

    <div class="sm:col-span-2">
      <%= f.label :description, class: "form-label" %>
      <%= f.text_area :description, rows: 2, class: "form-input" %>
    </div>

    <div class="sm:col-span-2">
      <%= f.label :system_prompt, class: "form-label" %>
      <%= f.text_area :system_prompt, rows: 6, class: "form-input" %>
    </div>

    <div>
      <%= f.label :temperature, class: "form-label" %>
      <%= f.number_field :temperature, step: 0.1, min: 0, max: 2, class: "form-input" %>
    </div>
  </div>

  <%= f.submit t("actions.save"), class: "btn-primary mt-6" %>
<% end %>
