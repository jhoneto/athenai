<div class="w-full max-w-4xl">
  <div class="mb-8 flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-text-primary"><%= t(".title") %></h1>
      <p class="mt-1 text-sm text-text-secondary"><%= t(".subtitle") %></p>
    </div>
    <%= link_to t(".open_swagger"), api_docs_path, target: "_blank", rel: "noopener", class: "btn-outline shrink-0" %>
  </div>

  <%# Autenticação %>
  <section class="mb-8">
    <h2 class="mb-3 text-lg font-semibold text-text-primary"><%= t(".auth_title") %></h2>
    <div class="card w-full space-y-4">
      <p class="text-sm text-text-secondary"><%= t(".auth_description") %></p>
      <div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-text-secondary"><%= t(".auth_header_label") %></p>
        <div class="rounded-lg bg-slate-100 px-4 py-3 font-mono text-sm text-text-primary">
          Authorization: Bearer <span class="text-primary-700">&lt;sua_api_key&gt;</span>
        </div>
      </div>
    </div>
  </section>

  <%# Agentes %>
  <section class="mb-8">
    <h2 class="mb-3 text-lg font-semibold text-text-primary"><%= t(".agents_title") %></h2>
    <div class="card w-full overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="text-xs uppercase tracking-wide text-text-secondary">
            <th class="pb-2 pr-4 font-medium"><%= t(".table.method") %></th>
            <th class="pb-2 pr-4 font-medium"><%= t(".table.path") %></th>
            <th class="pb-2 font-medium"><%= t(".table.description") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <tr>
            <td class="py-2 pr-4"><span class="rounded bg-green-100 px-2 py-0.5 text-xs font-bold text-green-700">GET</span></td>
            <td class="py-2 pr-4 font-mono text-xs text-text-primary">/api/v1/agents</td>
            <td class="py-2 text-text-secondary"><%= t(".agents_index_description") %></td>
          </tr>
          <tr>
            <td class="py-2 pr-4"><span class="rounded bg-green-100 px-2 py-0.5 text-xs font-bold text-green-700">GET</span></td>
            <td class="py-2 pr-4 font-mono text-xs text-text-primary">/api/v1/agents/:id</td>
            <td class="py-2 text-text-secondary"><%= t(".agents_show_description") %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <%# Sessions & Messages %>
  <section class="mb-8">
    <h2 class="mb-3 text-lg font-semibold text-text-primary"><%= t(".chat_title") %></h2>

    <div class="card w-full overflow-hidden divide-y divide-border">
      <div class="p-6 space-y-4">
        <div class="flex items-center gap-3">
          <span class="rounded bg-primary-100 px-2 py-0.5 text-xs font-bold text-primary-700">POST</span>
          <code class="text-sm font-mono text-text-primary">/api/v1/sessions</code>
          <span class="text-sm text-text-secondary">— <%= t(".sessions_create_description") %></span>
        </div>

        <div>
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-text-secondary"><%= t(".example_label") %></p>
          <div class="overflow-x-auto rounded-lg bg-slate-100 px-4 py-3">
            <pre class="text-xs text-text-primary leading-relaxed"><code>curl -X POST "https://app.athenai.com.br/api/v1/sessions?agent_id=<span class="text-primary-700">42</span>" \
  -H "Authorization: Bearer <span class="text-primary-700">SUA_API_KEY</span>"</code></pre>
          </div>
        </div>

        <div>
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-text-secondary"><%= t(".response_label") %> — 201 Created</p>
          <div class="overflow-x-auto rounded-lg bg-slate-100 px-4 py-3">
            <pre class="text-xs text-text-primary leading-relaxed"><code>{
  "id": 17,
  "agent_id": 42,
  "status": "open",
  "created_at": "2026-08-13T14:00:00.000Z"
}</code></pre>
          </div>
        </div>
      </div>

      <div class="p-6 space-y-4">
        <div class="flex items-center gap-3">
          <span class="rounded bg-primary-100 px-2 py-0.5 text-xs font-bold text-primary-700">POST</span>
          <code class="text-sm font-mono text-text-primary">/api/v1/sessions/:session_id/messages</code>
          <span class="text-sm text-text-secondary">— <%= t(".messages_create_description") %></span>
        </div>

        <div>
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-text-secondary"><%= t(".example_label") %></p>
          <div class="overflow-x-auto rounded-lg bg-slate-100 px-4 py-3">
            <pre class="text-xs text-text-primary leading-relaxed"><code>curl -X POST https://app.athenai.com.br/api/v1/sessions/17/messages \
  -H "Authorization: Bearer <span class="text-primary-700">SUA_API_KEY</span>" \
  -H "Content-Type: application/json" \
  -d '{ "message": { "content": "Olá, preciso de ajuda" } }'</code></pre>
          </div>
        </div>

        <div>
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-text-secondary"><%= t(".response_label") %> — 202 Accepted</p>
          <div class="overflow-x-auto rounded-lg bg-slate-100 px-4 py-3">
            <pre class="text-xs text-text-primary leading-relaxed"><code>{ "status": "queued" }</code></pre>
          </div>
        </div>
        <p class="text-xs text-text-secondary"><%= t(".messages_async_note") %></p>
      </div>

      <div class="p-6">
        <div class="flex items-center gap-3">
          <span class="rounded bg-green-100 px-2 py-0.5 text-xs font-bold text-green-700">GET</span>
          <code class="text-sm font-mono text-text-primary">/api/v1/sessions/:session_id/messages</code>
          <span class="text-sm text-text-secondary">— <%= t(".messages_index_description") %></span>
        </div>
      </div>
    </div>
  </section>

  <%# Conectores %>
  <section class="mb-8">
    <h2 class="mb-3 text-lg font-semibold text-text-primary"><%= t(".connectors_title") %></h2>
    <div class="card w-full overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="text-xs uppercase tracking-wide text-text-secondary">
            <th class="pb-2 pr-4 font-medium"><%= t(".table.method") %></th>
            <th class="pb-2 pr-4 font-medium"><%= t(".table.path") %></th>
            <th class="pb-2 font-medium"><%= t(".table.description") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <tr>
            <td class="py-2 pr-4"><span class="rounded bg-green-100 px-2 py-0.5 text-xs font-bold text-green-700">GET</span></td>
            <td class="py-2 pr-4 font-mono text-xs text-text-primary">/api/v1/connectors</td>
            <td class="py-2 text-text-secondary"><%= t(".connectors_index_description") %></td>
          </tr>
          <tr>
            <td class="py-2 pr-4"><span class="rounded bg-primary-100 px-2 py-0.5 text-xs font-bold text-primary-700">POST</span></td>
            <td class="py-2 pr-4 font-mono text-xs text-text-primary">/api/v1/connectors</td>
            <td class="py-2 text-text-secondary"><%= t(".connectors_create_description") %></td>
          </tr>
          <tr>
            <td class="py-2 pr-4"><span class="rounded bg-green-100 px-2 py-0.5 text-xs font-bold text-green-700">GET</span></td>
            <td class="py-2 pr-4 font-mono text-xs text-text-primary">/api/v1/connectors/:id</td>
            <td class="py-2 text-text-secondary"><%= t(".connectors_show_description") %></td>
          </tr>
          <tr>
            <td class="py-2 pr-4"><span class="rounded bg-green-100 px-2 py-0.5 text-xs font-bold text-green-700">GET</span></td>
            <td class="py-2 pr-4 font-mono text-xs text-text-primary">/api/v1/connectors/:connector_id/actions</td>
            <td class="py-2 text-text-secondary"><%= t(".connector_actions_index_description") %></td>
          </tr>
          <tr>
            <td class="py-2 pr-4"><span class="rounded bg-primary-100 px-2 py-0.5 text-xs font-bold text-primary-700">POST</span></td>
            <td class="py-2 pr-4 font-mono text-xs text-text-primary">/api/v1/connectors/:connector_id/actions</td>
            <td class="py-2 text-text-secondary"><%= t(".connector_actions_create_description") %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <%# Erros %>
  <section class="mb-8">
    <h2 class="mb-3 text-lg font-semibold text-text-primary"><%= t(".errors_title") %></h2>
    <div class="card w-full overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="text-xs uppercase tracking-wide text-text-secondary">
            <th class="pb-2 pr-4 font-medium"><%= t(".table.code") %></th>
            <th class="pb-2 font-medium"><%= t(".table.situation") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <tr>
            <td class="py-2 pr-4 font-mono text-green-600">201 / 202</td>
            <td class="py-2 text-text-secondary"><%= t(".errors.created") %></td>
          </tr>
          <tr>
            <td class="py-2 pr-4 font-mono text-red-500">401</td>
            <td class="py-2 text-text-secondary"><%= t(".errors.unauthorized") %></td>
          </tr>
          <tr>
            <td class="py-2 pr-4 font-mono text-red-500">404</td>
            <td class="py-2 text-text-secondary"><%= t(".errors.not_found") %></td>
          </tr>
          <tr>
            <td class="py-2 pr-4 font-mono text-red-500">422</td>
            <td class="py-2 text-text-secondary"><%= t(".errors.unprocessable") %></td>
          </tr>
          <tr>
            <td class="py-2 pr-4 font-mono text-red-500">429</td>
            <td class="py-2 text-text-secondary"><%= t(".errors.too_many_requests") %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</div>
