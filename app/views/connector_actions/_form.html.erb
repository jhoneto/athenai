<%= form_with model: connector_action, url: connector_actions_path(connector), class: "card w-full" do |f| %>
  <% if connector_action.errors.any? %>
    <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <%= connector_action.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: "form-input" %>
    </div>

    <div>
      <%= f.label :kind, class: "form-label" %>
      <%= f.select :kind, Connector::Action.kinds.keys.map { |kind| [ t("connector_actions.kinds.#{kind}"), kind ] },
            {}, class: "form-input" %>
    </div>

    <div class="sm:col-span-2">
      <%= f.label :description, class: "form-label" %>
      <%= f.text_area :description, rows: 2, class: "form-input" %>
    </div>

    <div class="sm:col-span-2">
      <%= f.label :definition, t("connector_actions.form.definition"), class: "form-label" %>
      <%= f.text_area :definition, rows: 3, value: connector_action.definition.presence&.to_json, class: "form-input" %>
    </div>

    <div class="sm:col-span-2">
      <%= f.label :input_schema, t("connector_actions.form.input_schema"), class: "form-label" %>
      <%= f.text_area :input_schema, rows: 3, value: connector_action.input_schema.presence&.to_json, class: "form-input" %>
    </div>
  </div>

  <%= f.submit t("actions.save"), class: "btn-primary mt-6" %>
<% end %>
