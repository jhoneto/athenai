<h2 class="mb-6 text-center text-xl font-semibold text-text-primary">Criar sua conta</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <% if resource.errors.any? %>
    <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <% resource.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="space-y-4">
    <div>
      <%= f.label :name, "Seu nome", class: "form-label" %>
      <%= f.text_field :name, autofocus: true, autocomplete: "name",
          class: "form-input text-sm" %>
    </div>

    <div>
      <%= f.label :account_name, "Nome da empresa", class: "form-label" %>
      <%= f.text_field :account_name, autocomplete: "organization",
          class: "form-input text-sm" %>
    </div>

    <div>
      <%= f.label :email, "E-mail", class: "form-label" %>
      <%= f.email_field :email, autocomplete: "email",
          class: "form-input text-sm" %>
    </div>

    <div>
      <%= f.label :password, "Senha", class: "form-label" %>
      <%= f.password_field :password, autocomplete: "new-password",
          class: "form-input text-sm" %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirmar senha", class: "form-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password",
          class: "form-input text-sm" %>
    </div>

    <%= f.submit "Criar conta",
        class: "mt-2 w-full btn-primary py-2.5 text-sm" %>
  </div>
<% end %>

<p class="mt-6 text-center text-sm text-text-secondary">
  Já tem uma conta?
  <%= link_to "Entrar", new_user_session_path,
      class: "font-medium text-primary-700 hover:text-primary-800 hover:underline" %>
</p>
