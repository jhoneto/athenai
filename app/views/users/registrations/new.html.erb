<h2 class="mb-6 text-center text-xl font-semibold text-ink dark:text-ink-dark">Criar sua conta</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <% if resource.errors.any? %>
    <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-800 dark:bg-red-950/60 dark:text-red-300">
      <% resource.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="space-y-4">
    <div>
      <%= f.label :name, "Seu nome", class: "block text-sm font-medium text-ink dark:text-ink-dark mb-1" %>
      <%= f.text_field :name, autofocus: true, autocomplete: "name",
          class: "block w-full rounded-lg border border-edge bg-canvas px-3 py-2 text-sm text-ink placeholder-gray-400 focus:border-brand-primary focus:outline-none focus:ring-1 focus:ring-brand-primary dark:border-edge-dark dark:bg-canvas-dark dark:text-ink-dark" %>
    </div>

    <div>
      <%= f.label :account_name, "Nome da empresa", class: "block text-sm font-medium text-ink dark:text-ink-dark mb-1" %>
      <%= f.text_field :account_name, autocomplete: "organization",
          class: "block w-full rounded-lg border border-edge bg-canvas px-3 py-2 text-sm text-ink placeholder-gray-400 focus:border-brand-primary focus:outline-none focus:ring-1 focus:ring-brand-primary dark:border-edge-dark dark:bg-canvas-dark dark:text-ink-dark" %>
    </div>

    <div>
      <%= f.label :email, "E-mail", class: "block text-sm font-medium text-ink dark:text-ink-dark mb-1" %>
      <%= f.email_field :email, autocomplete: "email",
          class: "block w-full rounded-lg border border-edge bg-canvas px-3 py-2 text-sm text-ink placeholder-gray-400 focus:border-brand-primary focus:outline-none focus:ring-1 focus:ring-brand-primary dark:border-edge-dark dark:bg-canvas-dark dark:text-ink-dark" %>
    </div>

    <div>
      <%= f.label :password, "Senha", class: "block text-sm font-medium text-ink dark:text-ink-dark mb-1" %>
      <%= f.password_field :password, autocomplete: "new-password",
          class: "block w-full rounded-lg border border-edge bg-canvas px-3 py-2 text-sm text-ink placeholder-gray-400 focus:border-brand-primary focus:outline-none focus:ring-1 focus:ring-brand-primary dark:border-edge-dark dark:bg-canvas-dark dark:text-ink-dark" %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirmar senha", class: "block text-sm font-medium text-ink dark:text-ink-dark mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password",
          class: "block w-full rounded-lg border border-edge bg-canvas px-3 py-2 text-sm text-ink placeholder-gray-400 focus:border-brand-primary focus:outline-none focus:ring-1 focus:ring-brand-primary dark:border-edge-dark dark:bg-canvas-dark dark:text-ink-dark" %>
    </div>

    <%= f.submit "Criar conta", class: "mt-2 w-full cursor-pointer rounded-lg bg-brand-primary px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-primary/90 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:ring-offset-2" %>
  </div>
<% end %>

<p class="mt-6 text-center text-sm text-gray-500 dark:text-gray-400">
  Já tem uma conta?
  <%= link_to "Entrar", new_user_session_path, class: "font-medium text-brand-primary hover:underline dark:text-brand-accent" %>
</p>
