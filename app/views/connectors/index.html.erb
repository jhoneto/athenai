<div class="w-full">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-text-primary"><%= t(".title") %></h1>
    <%= link_to t(".new_button"), new_connector_path, class: "btn-primary" %>
  </div>

  <div class="card w-full divide-y divide-border">
    <% if @connectors.empty? %>
      <p class="text-sm text-text-secondary py-4"><%= t(".empty") %></p>
    <% end %>

    <% @connectors.each do |connector| %>
      <div class="flex flex-wrap items-center justify-between gap-2 py-3">
        <div>
          <%= link_to connector.name, connector, class: "font-medium text-text-primary hover:text-primary-700" %>
          <p class="text-sm text-text-secondary"><%= t("connectors.kinds.#{connector.kind}") %></p>
        </div>
        <span class="badge badge-<%= connector.status %>"><%= t("connectors.statuses.#{connector.status}") %></span>
      </div>
    <% end %>
  </div>
</div>
