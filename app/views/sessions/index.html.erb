<div class="w-full">
  <h1 class="text-2xl font-bold text-text-primary mb-6"><%= t(".title") %></h1>

  <div class="card w-full mb-6">
    <% if @available_agents.empty? %>
      <p class="text-sm text-text-secondary"><%= t(".no_agents") %></p>
    <% else %>
      <%= form_with url: chat_sessions_path, class: "flex flex-wrap items-end gap-3" do |f| %>
        <div class="flex-1 min-w-48">
          <%= f.label :agent_id, t(".select_agent"), class: "form-label" %>
          <%= f.select :agent_id, @available_agents.map { |agent| [ agent.name, agent.id ] },
                {}, class: "form-input" %>
        </div>
        <%= f.submit t(".start_button"), class: "btn-primary" %>
      <% end %>
    <% end %>
  </div>

  <div class="card w-full divide-y divide-border">
    <% if @sessions.empty? %>
      <p class="text-sm text-text-secondary py-4"><%= t(".empty") %></p>
    <% end %>

    <% @sessions.each do |session| %>
      <div class="flex flex-wrap items-center justify-between gap-2 py-3">
        <div>
          <%= link_to session.title_or_default, chat_session_path(session), class: "font-medium text-text-primary hover:text-primary-700" %>
          <p class="text-sm text-text-secondary"><%= session.agent.name %></p>
        </div>
        <span class="badge badge-<%= session.status %>"><%= t("sessions.statuses.#{session.status}") %></span>
      </div>
    <% end %>
  </div>
</div>
