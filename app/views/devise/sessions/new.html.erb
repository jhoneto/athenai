<h2 class="mb-6 text-center text-xl font-semibold text-ink dark:text-ink-dark">Entrar na sua conta</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="space-y-4">
    <div>
      <%= f.label :email, "E-mail", class: "block text-sm font-medium text-ink dark:text-ink-dark mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
          class: "block w-full rounded-lg border border-edge bg-canvas px-3 py-2 text-sm text-ink placeholder-gray-400 focus:border-brand-primary focus:outline-none focus:ring-1 focus:ring-brand-primary dark:border-edge-dark dark:bg-canvas-dark dark:text-ink-dark" %>
    </div>

    <div>
      <%= f.label :password, "Senha", class: "block text-sm font-medium text-ink dark:text-ink-dark mb-1" %>
      <%= f.password_field :password, autocomplete: "current-password",
          class: "block w-full rounded-lg border border-edge bg-canvas px-3 py-2 text-sm text-ink placeholder-gray-400 focus:border-brand-primary focus:outline-none focus:ring-1 focus:ring-brand-primary dark:border-edge-dark dark:bg-canvas-dark dark:text-ink-dark" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "rounded border-edge" %>
        <%= f.label :remember_me, "Lembrar de mim", class: "text-sm text-gray-600 dark:text-gray-400" %>
      </div>
    <% end %>

    <%= f.submit "Entrar", class: "mt-2 w-full cursor-pointer rounded-lg bg-brand-primary px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-primary/90 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:ring-offset-2" %>
  </div>
<% end %>

<p class="mt-6 text-center text-sm text-gray-500 dark:text-gray-400">
  Não tem uma conta?
  <%= link_to "Criar conta", new_user_registration_path, class: "font-medium text-brand-primary hover:underline dark:text-brand-accent" %>
</p>

<p class="mt-2 text-center text-sm text-gray-500 dark:text-gray-400">
  <%= link_to "Esqueci minha senha", new_user_password_path, class: "font-medium text-brand-primary hover:underline dark:text-brand-accent" %>
</p>
