<h2 class="mb-6 text-center text-xl font-semibold text-text-primary">Entrar na sua conta</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="space-y-4">
    <div>
      <%= f.label :email, "E-mail", class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
          class: "form-input text-sm" %>
    </div>

    <div>
      <%= f.label :password, "Senha", class: "form-label" %>
      <%= f.password_field :password, autocomplete: "current-password",
          class: "form-input text-sm" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me,
            class: "rounded border-border text-primary-700 focus:ring-primary-500" %>
        <%= f.label :remember_me, "Lembrar de mim",
            class: "text-sm text-text-secondary" %>
      </div>
    <% end %>

    <%= f.submit "Entrar",
        class: "mt-2 w-full btn-primary py-2.5 text-sm" %>
  </div>
<% end %>

<div class="mt-6 space-y-2 text-center text-sm text-text-secondary">
  <p>
    Não tem uma conta?
    <%= link_to "Criar conta", new_user_registration_path,
        class: "font-medium text-primary-700 hover:text-primary-800 hover:underline" %>
  </p>
  <p>
    <%= link_to "Esqueci minha senha", new_user_password_path,
        class: "font-medium text-primary-700 hover:text-primary-800 hover:underline" %>
  </p>
</div>
